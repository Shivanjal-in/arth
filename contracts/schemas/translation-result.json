{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arth.app/contracts/translation-result.json",
  "title": "TranslationResult",
  "description": "Full-sentence translation. Streamed over SSE in field order: hindi, simpleMeaning, difficultWords.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "hindi", "simpleMeaning", "difficultWords"],
  "properties": {
    "source": { "type": "string", "description": "The normalized English text that was translated." },
    "hindi": { "type": "string", "minLength": 1, "description": "हिंदी अनुवाद — faithful translation." },
    "simpleMeaning": { "type": "string", "minLength": 1, "description": "भावार्थ — plainer Hindi that unpacks what the sentence is saying." },
    "difficultWords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["en", "hi"],
        "properties": { "en": { "type": "string" }, "hi": { "type": "string" } }
      }
    }
  }
}
