# Copy to .env. Never commit .env.
OPENAI_API_KEY=

# Same local Mongo the API uses (api/docker-compose.yml). For Atlas, paste the URI.
MONGODB_URI=mongodb://localhost:27017/arth

# Model routing (Section 8). Change here, never in code.
LLM_MODEL_TOP=gpt-5.6-terra
LLM_MODEL_TAIL=gpt-5.6-luna
LLM_TOP_TIER_SIZE=5000

# Pricing, USD per 1M tokens, batch rates already halved. CHECK THE LIVE PRICING PAGE
# before trusting the cost print — these moved three times Jul–Sep 2026.
PRICE_INPUT_gpt-5.6-terra=1.00
PRICE_OUTPUT_gpt-5.6-terra=6.00
PRICE_INPUT_gpt-5.6-luna=0.10
PRICE_OUTPUT_gpt-5.6-luna=0.60
PRICE_INPUT_gpt-5.6-sol=0.50
PRICE_OUTPUT_gpt-5.6-sol=3.00
