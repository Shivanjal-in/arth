# Copy to .env. Never commit .env.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB Atlas. Database name is the path segment; keep it `arth`.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arth

# --- LLM ---
OPENAI_API_KEY=
LLM_CONTEXT_MODEL=gpt-5.6-luna
LLM_TRANSLATE_MODEL=gpt-5.6-luna
# Index-only context path (Phase 3 experiment): model returns only a sense index,
# the note comes pre-written from the pipeline (senseNotes collection).
LLM_CONTEXT_INDEX_MODEL=gpt-5.6-luna
CONTEXT_MODE=live            # live | index
# Leave unset for the gpt-5.6 family (rejects the parameter).
# LLM_TEMPERATURE=0.3

# Per device (X-Device-Id header, else IP), per minute
RATE_LIMIT_LOOKUPS=60
RATE_LIMIT_LLM=20
RATE_LIMIT_PREFETCH=40
