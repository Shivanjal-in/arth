# Copy to .env. Never commit .env.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB Atlas. Database name is the path segment; keep it `arth`.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/arth

# --- LLM ---
OPENAI_API_KEY=
LLM_CONTEXT_MODEL=gpt-5.6-luna
LLM_TRANSLATE_MODEL=gpt-5.6-luna
# Index-only context path (Phase 3 experiment): model returns only a sense index,
# the note comes pre-written from the pipeline (senseNotes collection).
LLM_CONTEXT_INDEX_MODEL=gpt-5.6-luna
CONTEXT_MODE=live            # live | index
# Leave unset for the gpt-5.6 family (rejects the parameter).
# LLM_TEMPERATURE=0.3

# Per device (X-Device-Id header, else IP), per minute
RATE_LIMIT_LOOKUPS=60
RATE_LIMIT_LLM=20
RATE_LIMIT_PREFETCH=40

# Entries in the on-device dictionary (the most frequent first). Raising it
# makes phones fetch the extra range on their next daily update.
SEED_LIMIT=20000

# --- accounts ---
# Firebase project whose ID tokens the API accepts (Project settings → Project ID).
# Verifying tokens needs only the project id: Google's public keys are fetched.
FIREBASE_PROJECT_ID=
# Profile photos. From the Cloudinary console: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- AI allowances (enforced when FIREBASE_PROJECT_ID is set) ---
AI_FREE_LIMIT=100          # lifetime, free tier
AI_PRO_MONTHLY=1000        # per calendar month (UTC), pro tier; super is unlimited
# The free allowance is also per phone; this many free accounts may share it
AI_FREE_ACCOUNTS_PER_DEVICE=3

# --- push notifications ---
# Firebase → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or base64 it: base64 -i key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=
